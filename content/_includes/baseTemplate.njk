<!DOCTYPE html>
<html lang="en">

<head>
    <title>{{ title }}</title>
    <script src="{{ nesting }}script/main.js"></script>
    <meta content="text/html;charset=utf-8" http-equiv="Content-Type" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="{{ nesting }}favicon.ico" rel="icon" type="image/x-icon" />
    <link href="{{ nesting }}/stylesheet/structure.css"  rel="stylesheet">
</head>

<body class="{{ bodyClass }}">
    <header>
        {% include 'header.njk' %}
    </header>
    <main>
        {{ content | safe }}
    </main>
    <aside>
        {% include 'sidebar.njk' %}
    </aside>
    <footer>Footer</footer>
</body>

</html>